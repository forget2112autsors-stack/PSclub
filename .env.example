# Bu faylni .env ga nusxalang va qiymatlarni to'ldiring.
# .env git ga tushmaydi (.gitignore da).

# --------------------------------------------------------------- Supabase ---
# Supabase loyihasida: Project Settings -> Database -> Connection string.
#
# DATABASE_URL — "Session pooler" (port 5432, pooler.supabase.com manzili).
#   Doimiy ishlaydigan server uchun shu mos keladi va IPv4 orqali ishlaydi.
#   Transaction pooler (6543) ishlatmang: o'lchovda u har bir so'rovga
#   910 ms sarfladi, session pooler esa 209 ms — to'rt baravar farq.
# DIRECT_URL  — o'sha qiymatning o'zi; migratsiya uchun ishlatiladi.
#
# Parolda maxsus belgi bo'lsa (@ : / ?), uni URL-kodlash kerak:
#   @ -> %40   : -> %3A   / -> %2F   ? -> %3F

DATABASE_URL=postgresql://postgres.LOYIHA_REF:PAROL@aws-0-REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.LOYIHA_REF:PAROL@aws-0-REGION.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------ Server --
# Token imzosi uchun uzun tasodifiy matn. Yaratish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=almashtiring_tasodifiy_kalit

PORT=3000

# ------------------------------------------------- Faqat birinchi seed da ---
PSKLUB_CLUB_NAME=PS Klub
PSKLUB_OPERATOR_PIN=
PSKLUB_ADMIN_PIN=
PSKLUB_OWNER_PIN=

# ------------------------------------------------------------- Telegram ----
# @BotFather dan olinadigan token. Bo'sh bo'lsa bot ishga tushmaydi,
# tizimning qolgan qismi baribir ishlayveradi.
TELEGRAM_BOT_TOKEN=

# Kunlik xulosa soati (klub vaqti bo'yicha, 0-23).
TELEGRAM_DAILY_HOUR=9

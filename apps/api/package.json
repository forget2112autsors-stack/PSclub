{
  "name": "@psklub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API server — Fastify + Prisma + WebSocket",
  "scripts": {
    "dev": "node --no-warnings --watch src/index.ts",
    "start": "node --no-warnings src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "node --no-warnings prisma/seed.ts",
    "test": "node --no-warnings --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/static": "^10.1.4",
    "@prisma/client": "^6.16.1",
    "@psklub/domain": "*",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "prisma": "^6.16.1",
    "typescript": "^5.9.3"
  }
}
